{
  "version": 1,
  "pins": [
    {
      "arg": "DOTNET_VERSION",
      "file": "global.json",
      "json": "sdk.version"
    },
    {
      "arg": "GITVERSION_VERSION",
      "file": ".github/workflows/dotnet-core.yml",
      "regex": "^\\s*GITVERSION_VERSION:\\s*([0-9]+\\.[0-9]+\\.[0-9]+)\\s*$"
    },
    {
      "arg": "MONGODB_VERSION",
      "file": "Directory.Build.props",
      "xml": "MongoDBVersion"
    }
  ]
}
